{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asisten-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Website admin (React, hasil build di web/dist). Path di bawah ditangani Worker dulu.
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/telegram", "/setup", "/status"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asisten-ai-db",
      "database_id": "cc9859c0-2e7d-4b27-b2ad-2b6eb4e828cb",
      "migrations_dir": "migrations"
    }
  ],

  // Update Telegram diantrekan dulu supaya webhook langsung balas 200,
  // lalu diproses di consumer (boleh jalan sampai 15 menit).
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "asisten-ai-jobs" }],
    "consumers": [{ "queue": "asisten-ai-jobs", "max_batch_size": 1, "max_retries": 0 }]
  },

  // Workers AI: transkrip voice note (Whisper).
  "ai": { "binding": "AI" },

  "triggers": {
    "crons": [
      "*/5 * * * *", // cek pengingat tiap 5 menit
      "0 0 * * *",   // 07:00 WIB — briefing pagi
      "0 14 * * *"   // 21:00 WIB — rekap malam
    ]
  },

  "vars": {
    "MODEL": "claude-opus-5-5",                 // Claude via Puter
    "FALLBACK_MODEL": "@cf/zai-org/glm-5.3-flash", // cadangan gratis (Workers AI)
    "TIMEZONE_OFFSET": "+07:00",
    "OWNER_CHAT_ID": "1001715052"
  }
  // Secrets (pakai `npx wrangler secret put <NAMA>`):
  //   TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, PUTER_AUTH_TOKEN (opsional, lihat README)
}
